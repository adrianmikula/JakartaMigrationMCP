{
  "mcpServers": {
    "gradle": {
      "command": "./gradlew",
      "args": ["--no-daemon"]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/mcp-server-postgres",
        "--connection-string",
        "postgresql://postgres:postgres@localhost:5432/jakarta_migration"
      ]
    },
    "codebase-indexer": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-codebase-indexer"]
    }
  },
  "permission": {
    "allow": [
      "bash: ./gradlew *",
      "bash: gradle *",
      "bash: npx *",
      "bash: docker *",
      "bash: npm *",
      "bash: node *",
      "bash: git *",
      "bash: mise *"
    ]
  }
}
